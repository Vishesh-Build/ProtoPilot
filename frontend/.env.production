# Baked into the packaged desktop build (vite uses .env.production for
# `vite build`). This is the live Render backend every installed .exe talks
# to. Without this file the build falls back to http://localhost:8000, which
# only exists on a dev machine — installed apps then show "Can't reach server".
VITE_API_BASE_URL=https://protopilot-c60r.onrender.com
