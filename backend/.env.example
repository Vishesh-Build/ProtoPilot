# ProtoPilot backend — environment variables.
#
# Copy this to `.env` for local dev, or paste these keys into your host's
# dashboard (Render → Environment) for deployment. NEVER commit the real
# `.env` — it holds live secrets and is gitignored. This file has NO real
# values on purpose; it only documents which variables exist.
#
# Only the variables under "REQUIRED" must be set. Everything else has a
# working default in app/config.py and is optional.

# ============================================================
# REQUIRED
# ============================================================

# --- Meeting data storage ---
# "sqlite" (local dev, a file on disk) or "postgres" (deploy).
# On a host with an ephemeral disk (Render/Fly free tier) the sqlite file is
# wiped on every redeploy, losing meetings/transcripts/prototypes — so set
# this to "postgres" in the cloud to store meeting state in Neon alongside auth.
MEETING_STORE_BACKEND=postgres

# --- Database (Neon Postgres) ---
# Used by BOTH auth and (when MEETING_STORE_BACKEND=postgres) the meeting store.
# Async URL; the meeting store rewrites it to a sync driver itself.
#   postgresql+asyncpg://USER:PASSWORD@ep-xxxx.neon.tech/DBNAME?ssl=require
DATABASE_URL=

# --- Auth secret ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# --- Cookies ---
# true for a cloud backend over HTTPS (required for cross-origin login).
# Set false ONLY for local http:// testing.
COOKIE_SECURE=true

# --- Speech recognition ---
# "sarvam" in the cloud: local Whisper needs ~1.5GB RAM and crashes a 512MB
# free instance. "auto" locally (Whisper) if you have no Sarvam key.
ASR_PROVIDER=sarvam
SARVAM_API_KEY=

# --- LiveKit (video call) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# ============================================================
# LLM PROVIDERS — at least one recommended (Gemini leads if set).
# With none set, generation/extraction can't run.
# ============================================================
GEMINI_API_KEY=
GROQ_API_KEY=
NIM_API_KEY=
OPENROUTER_API_KEY=

# ============================================================
# OPTIONAL
# ============================================================

# --- Stitch (AI UI design; falls back to LLM-generated HTML if unset) ---
STITCH_API_KEY=
STITCH_STYLE_DIRECTION=

# --- Outbound email (forgot-password links; without it that endpoint 500s) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@protopilot.app
# Point this at your reset-password page.
PASSWORD_RESET_URL_BASE=

# --- Extra CORS origins (comma-separated). Only needed if a browser frontend
#     on another host must reach this backend; the desktop app doesn't need it.
EXTRA_CORS_ORIGINS=

# --- OAuth (Google / GitHub) — only if you use social login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
OAUTH_SUCCESS_REDIRECT_URL=
OAUTH_ERROR_REDIRECT_URL=
